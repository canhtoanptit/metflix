{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Webflix Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "description": "Prefix for first-party images, e.g. ghcr.io/acme/",
          "pattern": "^$|.*/$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "publicOrigin": {
          "type": "string",
          "description": "https://host (no path); empty derives it",
          "pattern": "^$|^https?://[^/]+$"
        },
        "environment": {
          "type": "string",
          "enum": ["development", "production"]
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "rateLimits": {
          "type": "object",
          "description": "Rate-limit overrides by policy name (kebab or camel case) \u2192 WEBFLIX_RATE_LIMIT_<POLICY>",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^([0-9]+/[0-9]+)?$",
            "description": "limit/windowSec, or empty for the default"
          }
        },
        "trustedProxyHops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "mediaTokenTtlSec": {
          "type": "integer",
          "minimum": 60
        },
        "schedulerIntervalSec": {
          "type": "integer",
          "minimum": 5
        },
        "valkeyKeyPrefix": {
          "type": "string"
        },
        "extraEnv": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Secret with WEBFLIX_MEDIA_TOKEN_KEYS"
        },
        "generateWithoutCluster": {
          "type": "boolean",
          "description": "Allow generating credentials when rendering without cluster access (throwaway renders only)"
        }
      },
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "description": "Defaults to the chart appVersion"
            },
            "digest": {
              "type": "string",
              "description": "sha256:... (overrides the tag)",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            }
          },
          "additionalProperties": false,
          "required": ["repository"]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "type": "integer",
              "description": "0 disables",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": ["integer", "string"]
            }
          },
          "additionalProperties": false
        },
        "databasePoolMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "shutdownDelaySec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": ["string", "integer"],
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
                },
                "memory": {
                  "type": ["string", "integer"],
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
                }
              },
              "additionalProperties": {
                "type": ["string", "integer"],
                "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": ["string", "integer"],
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
                },
                "memory": {
                  "type": ["string", "integer"],
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
                }
              },
              "additionalProperties": {
                "type": ["string", "integer"],
                "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
              }
            }
          },
          "additionalProperties": false
        },
        "extraEnv": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": ["integer", "string"]
            }
          },
          "additionalProperties": false
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": ["string", "integer"],
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
                },
                "memory": {
                  "type": ["string", "integer"],
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
                }
              },
              "additionalProperties": {
                "type": ["string", "integer"],
                "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": ["string", "integer"],
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
                },
                "memory": {
                  "type": ["string", "integer"],
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
                }
              },
              "additionalProperties": {
                "type": ["string", "integer"],
                "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|M|G|T)?$"
              }
            }
          },
          "additionalProperties": false
        },
        "extraEnv": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "web": {
