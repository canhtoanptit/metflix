# Build context for deploy/docker/Dockerfile (an allow-list: the repository holds packaged
# media, cluster state and other engineers' caches that must never enter an image).
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps/*/package.json
!packages/*/package.json
!tools/*/package.json
!e2e/package.json
!apps/api
!apps/web
!apps/admin
# The console's policy, shared by its Vite config and the Worker (a file without imports).
!apps/edge/src/console-policy.ts
!packages
!tools/media
!services/recs/scripts
!deploy/docker/web

# Never, even inside the allowed trees.
**/node_modules
**/dist
**/dist-mock
**/.turbo
**/.cache
**/.wrangler
**/.data
**/coverage
**/test-results
**/playwright-report
**/*.log
**/.DS_Store
**/.env
**/.env.*
**/.dev.vars*
**/*.tsbuildinfo
tools/media/test
