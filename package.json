{
  "name": "webflix",
  "private": true,
  "type": "module",
  "description": "Webflix: a streaming product that ships one codebase to Kubernetes and Cloudflare.",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=26.8.0 <27",
    "pnpm": ">=10.5.0 <11"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@webflix/api --filter=@webflix/web",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @webflix/e2e e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
