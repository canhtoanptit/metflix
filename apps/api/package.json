{
  "name": "@webflix/api",
  "version": "0.0.0",
  "private": true,
  "description": "Node entrypoint for the dev and k8s modes: HTTP server, worker, migrate and seed commands.",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts serve",
    "worker": "node src/main.ts worker",
    "migrate": "node src/main.ts migrate",
    "seed": "node src/main.ts seed",
    "build": "node scripts/bundle.ts",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "test": "vitest run",
    "test:services": "node ../../packages/adapters-node/scripts/with-services.ts vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@scalar/api-reference": "1.82.1",
    "@webflix/adapters-node": "workspace:*",
    "@webflix/adapters-stripe": "workspace:^",
    "@webflix/catalog": "workspace:*",
    "@webflix/contracts": "workspace:*",
    "@webflix/core": "workspace:*",
    "@webflix/db": "workspace:*",
    "@webflix/dev-idp": "workspace:*",
    "@webflix/email": "workspace:^",
    "@webflix/http": "workspace:*",
    "@webflix/payments-fake": "workspace:^",
    "hono": "catalog:",
    "kysely": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
