// Webflix on Cloudflare (blueprint §2.1, docs/CLOUDFLARE.md).
//
// Top level = LOCAL development (`make cf-dev`, `wrangler dev`, the workerd test suite): every
// binding is emulated by miniflare and persisted in .wrangler/state. Its resource ids are
// deliberately not real ids, so an accidental `wrangler deploy` without `--env` fails.
// `env.production` = the real account (`make cf-deploy`). Bindings, vars and secrets are not
// inherited by environments, so production restates all of them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webflix",
  "main": "src/index.ts",
  // Newest date the pinned runtime (workerd 1.20261119) supports. No compatibility flags: no
  // Node.js compatibility layer, the code is Web-standard (blueprint §2.1).
  "compatibility_date": "2026-11-19",

  // The SPA (apps/web build, staged with the API docs bundle and _headers by
  // `make cf-assets`) is served by the static-asset layer: free, cached, no Worker CPU.
  // Server-owned prefixes run the Worker first. A request that matches no file also reaches
  // the Worker ("none", not the asset layer's SPA mode): it answers client-side routes with
  // index.html and missing files with a 404 that nothing caches (src/spa.ts).
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "!/api/docs/scalar.js",
      "/media/*",
      "/cdn/*",
      "/healthz",
      "/readyz",
      // Milestone 2: the development issuer (answers 404 in production) and the fake
      // provider's payment form (billing area).
      "/dev-idp/*",
      "/_pay/*",
      // The staff console's settings (src/admin-console.ts); its files are static assets under
      // /admin/, and its client-side routes reach the Worker as misses (src/spa.ts).
      "/admin/config.json"
    ]
  },

  // Durable Object classes (SQLite storage) and the cache-enabled media origin entrypoint.
  // The default entrypoint (the gateway that authenticates) is never cached.
  "exports": {
    "RateLimiterObject": { "type": "durable-object", "storage": "sqlite" },
    "StreamGateObject": { "type": "durable-object", "storage": "sqlite" },
    "MediaOrigin": { "type": "worker", "cache": { "enabled": true } }
  },
  // Media cache entries are keyed by a media generation (bumped when media is replaced), not by
  // code: keep them warm across deploys.
  "cache": { "enabled": false, "cross_version_cache": true },

  // The scheduler only publishes idempotent jobs: stats rollups, baseline, cleanups and every
  // area's periodic jobs (playback expiry and outbox drain, the privacy sweep, billing
  // reconciliation, identity and audit cleanups). The queue consumer runs them.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Media tokens live in URL paths (/media/{token}/..., so HLS-relative URIs inherit them).
  // The platform's invocation logs and traces record the full URL and cannot redact a path,
  // so both are off; the record is our own access log (`http.request`, one JSON line per
  // request, tokens replaced by `:token`), persisted by Workers Logs. `wrangler tail` still
  // shows raw URLs live (operators only, not stored).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "upload_source_maps": true,

  // 8787 is the product's local URL (blueprint §8); the inspector stays in this mode's range.
  "dev": {
    "ip": "localhost",
    "port": 8787,
    "inspector_port": 4609,
    "local_protocol": "http"
  },

  // ---- Local bindings (miniflare) -----------------------------------------------------------
  "vars": {
    "WEBFLIX_MODE": "cloudflare",
    "WEBFLIX_ENV": "development",
    "WEBFLIX_PUBLIC_ORIGIN": "http://localhost:8787",
    "WEBFLIX_LOG_LEVEL": "info",
    "WEBFLIX_PASSWORD_ITERATIONS": "600000",
    "WEBFLIX_EDGE_CACHE": "on",
    // Exactly the Node dev mode's relaxed profile (apps/api/src/config.ts; a test compares the
    // composed limits): people, e2e suites and the conformance suite share the demo account
    // and 127.0.0.1 locally. Other policies keep their defaults, as in dev. Production keeps
    // the strict defaults. Run strict locally with
    // CF_DEV_FLAGS='--var WEBFLIX_RATE_LIMIT_AUTH:10/60 …' (docs/CLOUDFLARE.md §7).
    "WEBFLIX_RATE_LIMIT_AUTH": "60/60",
    "WEBFLIX_RATE_LIMIT_SIGNUP": "60/60",
    "WEBFLIX_RATE_LIMIT_EMAIL_LOOKUP": "300/60",
    "WEBFLIX_RATE_LIMIT_PROFILE_PIN": "60/60",
    "WEBFLIX_RATE_LIMIT_OIDC": "300/60",
    "WEBFLIX_RATE_LIMIT_EMAIL_SEND": "120/60",
    "WEBFLIX_RATE_LIMIT_EVENTS": "600/60",
    // ---- Milestone 2 (docs/CLOUDFLARE.md §10): every state in a binding, none in an isolate.
    // `app.version` of server events; production gets the deployed commit (scripts/deploy.ts).
    "WEBFLIX_RELEASE": "local",
    // Behaviour events: gzip NDJSON objects in R2 under events/ (written by the queue consumer).
    "WEBFLIX_EVENT_SINK": "lake",
    // Who runs the lake's jobs (erase, export-events, retain, compact) outside Workers. Read by
    // the production deploy only (scripts/lib/lake-jobs.ts); locally they are the make cf-*
    // targets and the CF_JOBS_EVERY loop.
    "WEBFLIX_LAKE_JOBS": "",
    // Email: recorded in D1 (`email_outbox`), read back by /diagnostics/mailbox from any isolate.
    "WEBFLIX_EMAIL_SENDER": "outbox",
    "WEBFLIX_EMAIL_FROM": "",
    // The fake provider: state in D1, its form at /_pay, webhooks processed by the queue consumer.
    "WEBFLIX_PAYMENT_PROVIDER": "fake",
    // Staff tokens from the development issuer this Worker serves at /dev-idp/staff.
    "WEBFLIX_STAFF_VERIFIER": "oidc",
    "WEBFLIX_STAFF_ISSUER": "",
    // Per-profile recommendation lists in KV (RECS), models and neighbours in D1.
    "WEBFLIX_RECOMMENDATION_STORE": "kv"
  },
  // Locally these come from .dev.vars (git-ignored), which `make cf-dev` writes once per clone:
  // random media-token and pseudonym keys, the provider credentials empty (= unset: the local
  // Worker uses the D1 outbox and the fake provider). Wrangler loads only the names listed
  // here from .dev.vars. Production requires each of them at deploy (docs/CLOUDFLARE.md §8).
  "secrets": {
    "required": [
      "WEBFLIX_MEDIA_TOKEN_KEYS",
      "WEBFLIX_PSEUDONYM_KEY",
      "WEBFLIX_EMAIL_HTTP_API_KEY",
      "WEBFLIX_EMAIL_WEBHOOK_SECRET",
      "STRIPE_SECRET_KEY",
      "STRIPE_PUBLISHABLE_KEY",
      "STRIPE_WEBHOOK_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webflix",
      "database_id": "webflix-local",
      // Generated from the TypeScript migrations (pnpm --filter @webflix/db generate).
      "migrations_dir": "../../packages/db/migrations/d1"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "webflix-local-cache" },
    { "binding": "RECS", "id": "webflix-local-recs" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "webflix-media" }],
  "durable_objects": {
    "bindings": [
      { "name": "LIMITS", "class_name": "RateLimiterObject" },
      { "name": "STREAMS", "class_name": "StreamGateObject" }
    ]
  },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "webflix-jobs" }],
    "consumers": [
      {
        "queue": "webflix-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        // 5 attempts in total (JOBS_MAX_ATTEMPTS in src/env.ts), then the dead-letter queue.
        "max_retries": 4,
        "retry_delay": 30,
        "max_concurrency": 2,
        "dead_letter_queue": "webflix-jobs-dlq"
      }
    ]
  },

  "env": {
    // ---- Production (a real account; ids are written by `make cf-provision`) ---------------
    "production": {
      "name": "webflix",
      // One public hostname: the origin in WEBFLIX_PUBLIC_ORIGIN. A custom domain there means
      // no workers.dev URL (it would bypass the zone's WAF and rate-limiting rules);
      // `make cf-provision` derives `workers_dev` and `routes` from that origin, so a first
      // deploy without a domain is an explicit https://webflix.<subdomain>.workers.dev origin.
      "workers_dev": false,
      "preview_urls": false,
      // Halves the upload (≈ 820 KiB raw, 195 KiB gzip) and trims startup; source maps are
      // uploaded for readable stack traces. Local dev stays unminified.
      "minify": true,
      // Same routing as local; staged separately (its _headers add HSTS) so a deploy never
      // rewrites what a running dev server serves.
      "assets": {
        "directory": "./dist/production-assets",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none",
        "run_worker_first": [
          "/api/*",
          "!/api/docs/scalar.js",
          "/media/*",
          "/cdn/*",
          "/healthz",
          "/readyz",
          "/dev-idp/*",
          "/_pay/*",
          "/admin/config.json"
        ]
      },
      // Guard rail against runaway CPU. The heaviest legitimate request is a sign-in for an
      // unknown address in a fresh isolate (two PBKDF2 derivations, ~80 ms at 600k
      // iterations); 1 s leaves an order of magnitude of headroom. Workers Paid.
      "limits": { "cpu_ms": 1000 },
      "vars": {
        "WEBFLIX_MODE": "cloudflare",
        "WEBFLIX_ENV": "production",
        // Set to the origin users load the app from (custom domain or workers.dev URL).
        "WEBFLIX_PUBLIC_ORIGIN": "https://webflix.example.com",
        "WEBFLIX_LOG_LEVEL": "info",
        "WEBFLIX_PASSWORD_ITERATIONS": "600000",
        "WEBFLIX_EDGE_CACHE": "on",
        // Empty = no override: production runs the strict defaults of @webflix/core (a test
        // checks the composed limits). Listed because vars are not inherited from the top level.
        "WEBFLIX_RATE_LIMIT_AUTH": "",
        "WEBFLIX_RATE_LIMIT_SIGNUP": "",
        "WEBFLIX_RATE_LIMIT_EMAIL_LOOKUP": "",
        "WEBFLIX_RATE_LIMIT_PROFILE_PIN": "",
        "WEBFLIX_RATE_LIMIT_OIDC": "",
        "WEBFLIX_RATE_LIMIT_EMAIL_SEND": "",
        "WEBFLIX_RATE_LIMIT_EVENTS": "",
        // Empty here: `make cf-deploy` passes the deployed commit (--var WEBFLIX_RELEASE:…).
        "WEBFLIX_RELEASE": "",
        "WEBFLIX_EVENT_SINK": "lake",
        // `scheduled` once a runner of the lake's jobs is set up as docs/CLOUDFLARE.md §10.4
        // describes. Empty: a deploy stops while WEBFLIX_EVENT_SINK is lake (deleted members
        // would stay in R2, batch exports would never finish, nothing would enforce retention).
        // The runner also needs the staff API open to its service account (below).
        "WEBFLIX_LAKE_JOBS": "",
        // Resend's REST API with WEBFLIX_EMAIL_HTTP_API_KEY; bounces arrive on its webhook.
        "WEBFLIX_EMAIL_SENDER": "http",
        // Set to an address on a domain verified with the email provider (empty: the default
        // `Webflix <no-reply@webflix.dev>`, which a provider will refuse to send from).
        "WEBFLIX_EMAIL_FROM": "",
        "WEBFLIX_PAYMENT_PROVIDER": "stripe",
        // Empty = `memory`: the staff API admits nobody until a staff issuer is configured
        // (set WEBFLIX_STAFF_VERIFIER to oidc and WEBFLIX_STAFF_ISSUER to its https issuer).
        "WEBFLIX_STAFF_VERIFIER": "",
        "WEBFLIX_STAFF_ISSUER": "",
        "WEBFLIX_RECOMMENDATION_STORE": "kv"
      },
      // `wrangler deploy` refuses to deploy while one of these is unset. `make cf-deploy` sets
      // the media-token and pseudonym keys on the first deploy (generated, or from your secret
      // manager) and takes the provider credentials from the environment (docs/CLOUDFLARE.md §8).
      "secrets": {
        "required": [
          "WEBFLIX_MEDIA_TOKEN_KEYS",
          "WEBFLIX_PSEUDONYM_KEY",
          "WEBFLIX_EMAIL_HTTP_API_KEY",
          "WEBFLIX_EMAIL_WEBHOOK_SECRET",
          "STRIPE_SECRET_KEY",
          "STRIPE_PUBLISHABLE_KEY",
          "STRIPE_WEBHOOK_SECRET"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "webflix",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations/d1"
        }
      ],
      // Placeholders until `make cf-provision` finds or creates `webflix-cache` and `webflix-recs`.
      "kv_namespaces": [
        { "binding": "CACHE", "id": "00000000000000000000000000000000" },
        { "binding": "RECS", "id": "00000000000000000000000000000000" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "webflix-media" }],
      "durable_objects": {
        "bindings": [
          { "name": "LIMITS", "class_name": "RateLimiterObject" },
          { "name": "STREAMS", "class_name": "StreamGateObject" }
        ]
      },
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "webflix-jobs" }],
        "consumers": [
          {
            "queue": "webflix-jobs",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 4,
            "retry_delay": 30,
            "max_concurrency": 2,
            "dead_letter_queue": "webflix-jobs-dlq"
          }
        ]
      }
    }
  }
}
