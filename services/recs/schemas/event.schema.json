{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webflix.dev/schemas/event/1",
  "title": "Webflix behaviour event (envelope version 1)",
  "description": "One event as stored in the event lake (docs/BLUEPRINT-M2.md §6.1). GENERATED from packages/contracts/src/events.ts by `pnpm --filter @webflix/contracts generate`; do not edit. Closed at every level: a new optional field is a new `version` of its type.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "source",
    "occurredAt",
    "receivedAt",
    "deviceId",
    "sessionSeq",
    "app",
    "context",
    "subject",
    "payload"
  ],
  "properties": {
    "eventId": {
      "description": "UUIDv7, generated where the event is created. The lake's deduplication key.",
      "$ref": "#/$defs/uuidv7"
    },
    "type": {
      "$ref": "#/$defs/eventType"
    },
    "version": {
      "description": "Version of this type's payload schema. Readers accept the versions they know and count the rest.",
      "type": "integer",
      "const": 1
    },
    "source": {
      "description": "`client` events come from the telemetry SDK (untrusted clock and ids); `server` events from Webflix services.",
      "enum": ["client", "server"]
    },
    "occurredAt": {
      "description": "When it happened, by the producer's clock.",
      "$ref": "#/$defs/timestamp"
    },
    "receivedAt": {
      "description": "When ingestion accepted it (server clock). The lake partition comes from this.",
      "$ref": "#/$defs/timestamp"
    },
    "deviceId": {
      "description": "Anonymous device id; null on server events not tied to a device.",
      "anyOf": [
        {
          "$ref": "#/$defs/opaqueId"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionSeq": {
      "description": "Per-device counter within the app session; null on server events.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "app": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["web", "ios", "android", "tv", "server"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": ["platform", "version"],
      "additionalProperties": false
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/dispatch/impression"
    },
    {
      "$ref": "#/$defs/dispatch/row.view"
    },
    {
      "$ref": "#/$defs/dispatch/title.open"
    },
    {
      "$ref": "#/$defs/dispatch/preview.start"
    },
    {
      "$ref": "#/$defs/dispatch/preview.complete"
    },
    {
      "$ref": "#/$defs/dispatch/search.query"
    },
    {
      "$ref": "#/$defs/dispatch/search.click"
    },
    {
      "$ref": "#/$defs/dispatch/list.add"
    },
    {
      "$ref": "#/$defs/dispatch/list.remove"
    },
    {
      "$ref": "#/$defs/dispatch/rating.set"
    },
    {
      "$ref": "#/$defs/dispatch/rating.clear"
    },
    {
      "$ref": "#/$defs/dispatch/signup.step"
    },
    {
      "$ref": "#/$defs/dispatch/client.error"
    },
    {
      "$ref": "#/$defs/dispatch/playback.start"
    },
    {
      "$ref": "#/$defs/dispatch/playback.progress"
    },
    {
      "$ref": "#/$defs/dispatch/playback.complete"
    },
    {
      "$ref": "#/$defs/dispatch/playback.abandon"
    },
    {
      "$ref": "#/$defs/dispatch/billing.transition"
    },
    {
      "$ref": "#/$defs/dispatch/auth.signin"
    },
    {
      "$ref": "#/$defs/dispatch/auth.signup"
    },
    {
      "$ref": "#/$defs/dispatch/experiment.exposure"
    },
    {
      "$ref": "#/$defs/dispatch/consent.change"
    }
  ],
  "$defs": {
    "eventType": {
      "enum": [
        "impression",
        "row.view",
        "title.open",
        "preview.start",
        "preview.complete",
        "search.query",
        "search.click",
        "list.add",
        "list.remove",
        "rating.set",
        "rating.clear",
        "signup.step",
        "client.error",
        "playback.start",
        "playback.progress",
        "playback.complete",
        "playback.abandon",
        "billing.transition",
        "auth.signin",
        "auth.signup",
        "experiment.exposure",
        "consent.change"
      ]
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "titleId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "pseudonym": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "context": {
      "type": "object",
      "properties": {
        "surface": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "home",
                "series",
                "movies",
                "new-popular",
                "genre",
                "search",
                "title-detail",
                "my-list",
                "player",
                "account",
                "signup",
                "landing"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rowId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "rowRank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "experiments": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "policy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "explore": {
                  "type": "boolean"
                }
              },
              "required": ["id", "explore"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["surface", "rowId", "rowRank", "rank", "experiments", "policy"],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "account": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["basic", "standard", "premium"]
            },
            {
              "type": "null"
            }
          ]
        },
        "country": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "restricted": {
          "type": "boolean"
        },
        "consent": {
          "type": "object",
          "properties": {
            "analytics": {
              "type": "boolean"
            },
            "personalisation": {
              "type": "boolean"
            }
          },
          "required": ["analytics", "personalisation"],
          "additionalProperties": false
        }
      },
      "required": ["account", "profile", "plan", "country", "restricted", "consent"],
      "additionalProperties": false
    },
    "payloads": {
      "impression": {
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "sampleRate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "required": ["titleId", "sampleRate"],
        "additionalProperties": false
      },
      "row.view": {
        "type": "object",
        "properties": {
          "rowKind": {
            "type": "string",
            "enum": [
              "billboard",
              "continue-watching",
              "my-list",
              "top-10",
              "trending",
              "new-releases",
              "because-you-watched",
              "genre",
              "watch-again",
              "originals",
              "top-picks",
              "collection"
            ]
          },
          "itemCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sampleRate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "required": ["rowKind", "itemCount", "sampleRate"],
        "additionalProperties": false
      },
      "title.open": {
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": ["titleId"],
        "additionalProperties": false
      },
      "preview.start": {
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": ["titleId"],
        "additionalProperties": false
      },
      "preview.complete": {
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "watchedSec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["titleId", "watchedSec"],
        "additionalProperties": false
      },
      "search.query": {
        "type": "object",
        "properties": {
          "queryLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "resultCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["queryLength", "resultCount"],
        "additionalProperties": false
      },
      "search.click": {
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "resultRank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "queryLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": ["titleId", "resultRank", "queryLength"],
        "additionalProperties": false
      },
      "list.add": {
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": ["titleId"],
        "additionalProperties": false
      },
      "list.remove": {
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": ["titleId"],
        "additionalProperties": false
      },
      "rating.set": {
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "value": {
            "type": "string",
            "enum": ["dislike", "like", "love"]
          }
        },
        "required": ["titleId", "value"],
        "additionalProperties": false
      },
      "rating.clear": {
        "type": "object",
        "properties": {
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": ["titleId"],
        "additionalProperties": false
      },
      "signup.step": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": ["email", "plan", "payment", "profiles", "complete"]
          },
          "outcome": {
            "type": "string",
            "enum": ["viewed", "completed", "failed"]
          }
        },
        "required": ["step", "outcome"],
        "additionalProperties": false
      },
      "client.error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "fatal": {
            "type": "boolean"
          }
        },
        "required": ["code", "fatal"],
        "additionalProperties": false
      },
      "playback.start": {
        "type": "object",
        "properties": {
          "playbackSessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "episodeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "positionSec": {
            "type": "number",
            "minimum": 0
          },
          "durationSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "watchedSec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "playbackSessionId",
          "titleId",
          "episodeId",
          "positionSec",
          "durationSec",
          "watchedSec"
        ],
        "additionalProperties": false
      },
      "playback.progress": {
        "type": "object",
        "properties": {
          "playbackSessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "episodeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "positionSec": {
            "type": "number",
            "minimum": 0
          },
          "durationSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "watchedSec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "playbackSessionId",
          "titleId",
          "episodeId",
          "positionSec",
          "durationSec",
          "watchedSec"
        ],
        "additionalProperties": false
      },
      "playback.complete": {
        "type": "object",
        "properties": {
          "playbackSessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "episodeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "positionSec": {
            "type": "number",
            "minimum": 0
          },
          "durationSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "watchedSec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "playbackSessionId",
          "titleId",
          "episodeId",
          "positionSec",
          "durationSec",
          "watchedSec"
        ],
        "additionalProperties": false
      },
      "playback.abandon": {
        "type": "object",
        "properties": {
          "playbackSessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "titleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "episodeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "positionSec": {
            "type": "number",
            "minimum": 0
          },
          "durationSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "watchedSec": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "enum": ["closed", "error", "stalled", "replaced", "expired"]
          }
        },
        "required": [
          "playbackSessionId",
          "titleId",
          "episodeId",
          "positionSec",
          "durationSec",
          "watchedSec",
          "reason"
        ],
        "additionalProperties": false
      },
      "billing.transition": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "none",
              "incomplete",
              "trialing",
              "active",
              "past_due",
              "suspended",
              "canceled"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "none",
              "incomplete",
              "trialing",
              "active",
              "past_due",
              "suspended",
              "canceled"
            ]
          },
          "planId": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["basic", "standard", "premium"]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["from", "to", "planId"],
        "additionalProperties": false
      },
      "auth.signin": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": ["password", "oidc"]
          },
          "outcome": {
            "type": "string",
            "enum": ["success", "failure"]
          }
        },
        "required": ["method", "outcome"],
        "additionalProperties": false
      },
      "auth.signup": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": ["password", "oidc"]
          },
          "outcome": {
            "type": "string",
            "enum": ["success", "failure"]
          }
        },
        "required": ["method", "outcome"],
        "additionalProperties": false
      },
      "experiment.exposure": {
        "type": "object",
        "properties": {
          "experimentKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "variant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "unitType": {
            "type": "string",
            "enum": ["profile", "device"]
          }
        },
        "required": ["experimentKey", "variant", "unitType"],
        "additionalProperties": false
      },
      "consent.change": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": ["analytics", "personalisation"]
          },
          "granted": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": ["banner", "settings", "gpc", "support"]
          }
        },
        "required": ["purpose", "granted", "source"],
        "additionalProperties": false
      }
    },
    "dispatch": {
      "impression": {
        "if": {
          "properties": {
            "type": {
              "const": "impression"
            }
          }
        },
        "then": {
          "properties": {
            "source": {
              "const": "client"
            },
            "payload": {
              "$ref": "#/$defs/payloads/impression"
            },
            "deviceId": {
              "$ref": "#/$defs/opaqueId"
            },
            "sessionSeq": {
              "type": "integer",
              "minimum": 0
            },
            "app": {
              "properties": {
                "platform": {
                  "enum": ["web", "ios", "android", "tv"]
                }
              }
            }
          }
        }
      },
      "row.view": {
        "if": {
          "properties": {
            "type": {
              "const": "row.view"
            }
          }
        },
        "then": {
          "properties": {
            "source": {
              "const": "client"
            },
            "payload": {
              "$ref": "#/$defs/payloads/row.view"
            },
            "deviceId": {
              "$ref": "#/$defs/opaqueId"
            },
            "sessionSeq": {
              "type": "integer",
              "minimum": 0
            },
            "app": {
              "properties": {
                "platform": {
                  "enum": ["web", "ios", "android", "tv"]
                }
              }
            }
          }
        }
      },
      "title.open": {
        "if": {
          "properties": {
            "type": {
              "const": "title.open"
            }
          }
        },
        "then": {
          "properties": {
            "source": {
              "const": "client"
            },
            "payload": {
              "$ref": "#/$defs/payloads/title.open"
            },
            "deviceId": {
              "$ref": "#/$defs/opaqueId"
            },
            "sessionSeq": {
              "type": "integer",
              "minimum": 0
            },
            "app": {
