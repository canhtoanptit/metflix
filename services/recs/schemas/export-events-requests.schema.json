{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webflix.dev/schemas/export-events-requests/1",
  "title": "Pending exports of members' events (the input of export-events)",
  "description": "The answer the product's operator route is expected to give (services/recs/README.md, \"Exports of members' events\"); until it exists, a file of this shape. One request per pending data export: its id (a private document name), the account's pseudonymous key and the receipt window [from, to).",
  "type": "object",
  "required": ["requests"],
  "properties": {
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requestId", "accountKey", "from", "to"],
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "accountKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
          }
        }
      }
    }
  }
}
