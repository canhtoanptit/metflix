{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webflix.dev/schemas/export-events-manifest/1",
  "title": "One export's events: the manifest",
  "description": "privacy/export-events/{requestId}/manifest.json, written by export-events after the events file it describes; its presence means that file is complete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "requestId",
    "accountKey",
    "from",
    "to",
    "events",
    "file",
    "bytes",
    "sha256",
    "generatedAt"
  ],
  "properties": {
    "format": {
      "const": "webflix.export-events"
    },
    "formatVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "accountKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "to": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "events": {
      "description": "Lines in the events file.",
      "type": "integer",
      "minimum": 0
    },
    "file": {
      "description": "privacy/export-events/{requestId}/events.ndjson.gz: gzip, one event per line exactly as the lake stored it, once per eventId, by receipt then id.",
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "description": "Of the gzip bytes of `file`.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    }
  }
}
