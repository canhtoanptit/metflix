{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webflix.dev/schemas/experiment-results-pointer/1",
  "title": "The current experiment results",
  "description": "experiments/results/current.json, written last by `analyse-experiments` after every file it names. An importer reads it, reads each result, checks `bytes` and `sha256`, and imports the documents; a run directory it does not name is never read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "run",
    "computedAt",
    "asOf",
    "report",
    "results",
    "skipped",
    "previous"
  ],
  "properties": {
    "format": {
      "const": "webflix.experiment-results-pointer"
    },
    "formatVersion": {
      "const": 1
    },
    "run": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[0-9]{3}$"
    },
    "computedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "asOf": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "report": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "path", "bytes", "sha256", "decision"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision": {
            "type": "string"
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "reason"],
        "properties": {
          "key": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "previous": {
      "type": ["string", "null"]
    }
  }
}
